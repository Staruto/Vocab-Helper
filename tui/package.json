{
  "name": "vocabhelper-tui",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test src/*.test.ts",
    "check": "npm run build && tsc -p tsconfig.check.json && npm test"
  },
  "dependencies": {
    "ink": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.1",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}

